# ---------------------------------------------------------------------------
# Live "indexed records" counter — data source configuration
# ---------------------------------------------------------------------------
# The /api/indexed-count route tries the data sources below in order:
#   1. Postgres (if PG_HOST is set)        -> exact COUNT from the index DB
#   2. Elasticsearch (if ES_URL is set)    -> sum of open + closed index doc counts
#   3. Estimate (always, as a fallback)    -> baseline + rate, clearly flagged
#
# When neither DB is configured (e.g. local preview / a static-only deploy),
# the counter still animates using the estimate so the page never looks broken.

# --- Postgres (preferred; mirrors ml-novelty-batch-openalex) ---
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# Set to "true" / "require" to connect over TLS.
PG_SSL=
# Override the count query if you want a different definition of "indexed record".
# Default: SELECT COUNT(*) FROM openalex.works_batch
INDEXED_COUNT_QUERY=

# --- Elasticsearch (used only if PG_HOST is empty) ---
ES_URL=
ES_USERNAME=
ES_PASSWORD=
# Comma-separated list of indices whose doc counts are summed.
ES_OPEN_INDEX=
ES_CLOSED_INDEX=

# --- Estimate fallback / interpolation rate ---
# Records added per second. Used to smoothly interpolate the counter upward
# between live polls, and as the growth rate in pure-estimate mode.
INDEXED_RECORDS_PER_SECOND=4.2
# Baseline used ONLY in estimate mode (no DB configured).
INDEXED_COUNT_BASELINE=248000000
# ISO timestamp the baseline was accurate as of (estimate mode only).
INDEXED_COUNT_BASELINE_AT=2026-06-01T00:00:00Z

# How long (seconds) the server caches a live DB count before re-querying.
INDEXED_COUNT_TTL_SECONDS=20
